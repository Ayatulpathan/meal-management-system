rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Members collection
    match /members/{memberId} {
      allow read, write: if true;
    }

    // Months collection and all subcollections (meals, marketCosts, deposits)
    match /months/{monthId} {
      allow read, write: if true;

      match /meals/{memberId} {
        allow read, write: if true;
      }

      match /marketCosts/{costId} {
        allow read, write: if true;
      }

      match /deposits/{depositId} {
        allow read, write: if true;
      }
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
